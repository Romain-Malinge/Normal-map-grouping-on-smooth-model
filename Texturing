import bpy
import os

MESH_NAME = "Patatoide_lisse"
BASE_DIR = os.path.join(os.path.expanduser("~"), "Documents", "Github", "Normal-map-grouping-on-smooth-model")
IMAGE_DIR = os.path.join(BASE_DIR, "images", "patatoide")
BAKE_DIR = os.path.join(BASE_DIR, "baked")
TEXTURE_RES = 4096

os.makedirs(BAKE_DIR, exist_ok=True)

bpy.context.scene.render.engine = 'CYCLES'
mesh = bpy.data.objects[MESH_NAME]

# -------------------------------
# Crée le matériau temporaire
# -------------------------------
mat = bpy.data.materials.new("ProjectionMat")
mat.use_nodes = True
mesh.data.materials.clear()
mesh.data.materials.append(mat)

nodes = mat.node_tree.nodes
links = mat.node_tree.links
nodes.clear()

tex_node = nodes.new("ShaderNodeTexImage")
tex_node.interpolation = 'Closest'  # important pour proj camera
tex_node.extension = 'CLIP'

tex_coord = nodes.new("ShaderNodeTexCoord")
mapping = nodes.new("ShaderNodeMapping")
bsdf = nodes.new("ShaderNodeBsdfPrincipled")
output = nodes.new("ShaderNodeOutputMaterial")

# Node links
links.new(tex_coord.outputs['Camera'], mapping.inputs['Vector'])
links.new(mapping.outputs['Vector'], tex_node.inputs['Vector'])
links.new(tex_node.outputs['Color'], bsdf.inputs['Base Color'])
links.new(bsdf.outputs['BSDF'], output.inputs['Surface'])

nodes.active = tex_node  # obligatoire pour bake

# -------------------------------
# Projection par caméra
# -------------------------------
image_files = sorted([f for f in os.listdir(IMAGE_DIR) if f.lower().endswith((".png", ".jpg", ".jpeg"))])
cameras = sorted([obj for obj in bpy.data.objects if obj.type == 'CAMERA'])

# pour test
image_files = [image_files[0]]

if len(image_files) != len(cameras):
    raise ValueError("Nombre de caméras et d'images doit correspondre !")

for cam, img_file in zip(cameras, image_files):
    print(f"📸 Projection et bake pour {cam.name} avec {img_file}")

    # Active la caméra
    bpy.context.scene.camera = cam

    # Charge l'image
    img_path = os.path.join(IMAGE_DIR, img_file)
    img = bpy.data.images.load(img_path)
    tex_node.image = img

    # CONTEXTE CLEAN
    bpy.ops.object.mode_set(mode='OBJECT')
    bpy.ops.object.select_all(action='DESELECT')
    mesh.select_set(True)
    bpy.context.view_layer.objects.active = mesh

    # Important : Node actif pour bake
    nodes.active = tex_node

    # BAKE EMIT pour capturer exactement la projection, sans lumière
    bpy.ops.object.bake(
        type='EMIT',
        use_clear=True,
        use_selected_to_active=False
    )

    # Sauvegarde le résultat
    save_path = os.path.join(BAKE_DIR, f"{cam.name}_{os.path.splitext(img_file)[0]}.png")
    img.filepath_raw = save_path
    img.file_format = 'PNG'
    img.save()
